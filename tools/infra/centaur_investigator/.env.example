# Read-only Centaur Postgres DSN. A database name can be supplied in the URL or
# selected with CENTAUR_INVESTIGATOR_POSTGRES_DATABASE (default: ai_v2).
CENTAUR_POSTGRES_DSN=postgresql://readonly:replace-me@localhost:5432/ai_v2

# Bot credential used only for read-only Discord message/channel lookups.
DISCORD_BOT_TOKEN=replace-me

# Optional observability endpoints.
VICTORIALOGS_URL=http://localhost:9428
VICTORIAMETRICS_URL=http://localhost:8428
